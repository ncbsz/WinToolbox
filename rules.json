        {
          "op": "reg_set",
          "key": "HKLM\\SYSTEM\\CurrentControlSet\\Control\\Session Manager\\Power",
          "value": "HiberbootEnabled",
          "type": "REG_DWORD",
          "data": 0
        }
      ],
      "restore": [
        {
          "op": "reg_set",
          "key": "HKLM\\SYSTEM\\CurrentControlSet\\Control\\Session Manager\\Power",
          "value": "HiberbootEnabled",
          "type": "REG_DWORD",
          "data": 1
        }
      ]
    },
