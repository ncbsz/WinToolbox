{
  "version": "1.2",
  "note": "数据驱动优化规则。risk=policy 的项写入 HKLM/HKCU\\SOFTWARE\\Policies，会让 Windows 显示“由你的组织管理”，界面上会标注【策略】并默认不勾选，需手动勾选后才会修改。",
  "categories": [
    {
      "key": "explorer",
      "name": "资源管理器",
      "icon": "folder"
    },
    {
      "key": "performance",
      "name": "性能优化",
      "icon": "speed"
    },
    {
      "key": "privacy",
      "name": "隐私保护",
      "icon": "shield"
    },
    {
      "key": "edge",
      "name": "Edge 浏览器",
      "icon": "globe"
    },
    {
      "key": "security",
      "name": "安全防护",
      "icon": "lock"
    },
    {
      "key": "system",
      "name": "系统偏好",
      "icon": "settings"
    }
  ],
  "rules": [
    {
      "id": "exp_searchbox",
      "category": "explorer",
      "risk": "safe",
      "name": "隐藏任务栏搜索框",
      "desc": "任务栏搜索框改为仅图标/隐藏，腾出任务栏空间",
      "checkKey": "HKCU\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Search",
      "checkValue": "SearchboxTaskbarMode",
      "optimizedValue": 0,
      "optimize": [
        {
          "op": "reg_set",
          "key": "HKCU\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Search",
          "value": "SearchboxTaskbarMode",
          "type": "REG_DWORD",
          "data": 0
        }
      ],
      "restore": [
        {
          "op": "reg_del",
          "key": "HKCU\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Search",
          "value": "SearchboxTaskbarMode"
        }
      ]
    },
    {
      "id": "exp_taskview",
      "category": "explorer",
      "risk": "safe",
      "name": "隐藏任务视图按钮",
      "desc": "去掉任务栏上的“任务视图”按钮",
      "checkKey": "HKCU\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced",
      "checkValue": "ShowTaskViewButton",
      "optimizedValue": 0,
      "optimize": [
        {
          "op": "reg_set",
          "key": "HKCU\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced",
          "value": "ShowTaskViewButton",
          "type": "REG_DWORD",
          "data": 0
        }
      ],
      "restore": [
        {
          "op": "reg_del",
          "key": "HKCU\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced",
          "value": "ShowTaskViewButton"
        }
      ]
    },
    {
      "id": "exp_ext",
      "category": "explorer",
      "risk": "safe",
      "name": "显示文件扩展名",
      "desc": "让资源管理器始终显示已知文件类型的扩展名，避免 .exe 伪装成 .jpg",
      "checkKey": "HKCU\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced",
      "checkValue": "HideFileExt",
      "optimizedValue": 0,
      "optimize": [
        {
          "op": "reg_set",
          "key": "HKCU\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced",
          "value": "HideFileExt",
          "type": "REG_DWORD",
          "data": 0
        }
      ],
      "restore": [
        {
          "op": "reg_set",
          "key": "HKCU\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced",
          "value": "HideFileExt",
          "type": "REG_DWORD",
          "data": 1
        }
      ]
    },
    {
      "id": "exp_thispc",
      "category": "explorer",
      "risk": "safe",
      "name": "打开资源管理器直接进“此电脑”",
      "desc": "跳过“快速访问主页”，直接打开此电脑",
      "checkKey": "HKCU\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced",
      "checkValue": "LaunchTo",
      "optimizedValue": 1,
      "optimize": [
        {
          "op": "reg_set",
          "key": "HKCU\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced",
          "value": "LaunchTo",
          "type": "REG_DWORD",
          "data": 1
        }
      ],
      "restore": [
        {
          "op": "reg_set",
          "key": "HKCU\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced",
          "value": "LaunchTo",
          "type": "REG_DWORD",
          "data": 3
        }
      ]
    },
    {
      "id": "exp_recent",
      "category": "explorer",
      "risk": "safe",
      "name": "不记录“最近打开的文件”",
