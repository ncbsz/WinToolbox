          "value": "AutoReboot",
          "type": "REG_DWORD",
          "data": 1
        }
      ]
    },
    {
      "id": "priv_telemetry",
      "category": "privacy",
      "risk": "safe",
      "name": "关闭诊断数据收集（服务级）",
      "desc": "禁用 DiagTrack 遥测服务，减少后台上报（不影响“由组织管理”显示）",
