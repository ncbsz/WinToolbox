          "key": "HKCU\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced",
          "value": "Start_TrackDocs",
          "type": "REG_DWORD",
          "data": 0
        }
      ],
      "restore": [
        {
          "op": "reg_set",
          "key": "HKCU\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced",
          "value": "Start_TrackDocs",
          "type": "REG_DWORD",
          "data": 1
        }
      ]
    },
    {
      "id": "exp_quickaccess",
      "category": "explorer",
      "risk": "safe",
      "name": "快速访问不显示常用文件夹",
      "desc": "隐藏快速访问里的“常用文件夹”列表",
      "checkKey": "HKCU\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Explorer",
      "checkValue": "ShowFrequent",
      "optimizedValue": 0,
      "optimize": [
        {
          "op": "reg_set",
          "key": "HKCU\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Explorer",
          "value": "ShowFrequent",
          "type": "REG_DWORD",
          "data": 0
        }
      ],
      "restore": [
        {
          "op": "reg_del",
          "key": "HKCU\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Explorer",
          "value": "ShowFrequent"
        }
      ]
    },
    {
      "id": "exp_autoplay",
      "category": "explorer",
      "risk": "safe",
      "name": "禁止自动播放（防 U 盘病毒）",
      "desc": "关闭所有驱动器的自动播放，可阻断 autorun.inf 类 U 盘病毒",
      "checkKey": "HKCU\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Explorer\\AutoplayHandlers",
      "checkValue": "DisableAutoplay",
      "optimizedValue": 1,
      "optimize": [
        {
          "op": "reg_set",
          "key": "HKCU\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Explorer\\AutoplayHandlers",
          "value": "DisableAutoplay",
          "type": "REG_DWORD",
          "data": 1
        }
      ],
      "restore": [
        {
          "op": "reg_del",
          "key": "HKCU\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Explorer\\AutoplayHandlers",
          "value": "DisableAutoplay"
        }
      ]
    },
    {
      "id": "exp_sep",
      "category": "explorer",
      "risk": "safe",
      "name": "在独立进程中打开文件夹窗口",
      "desc": "一个窗口崩溃不会带走整个资源管理器",
      "checkKey": "HKCU\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced",
      "checkValue": "SeparateProcess",
      "optimizedValue": 1,
      "optimize": [
        {
          "op": "reg_set",
          "key": "HKCU\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced",
          "value": "SeparateProcess",
          "type": "REG_DWORD",
          "data": 1
        }
      ],
      "restore": [
        {
          "op": "reg_set",
          "key": "HKCU\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Explorer\\Advanced",
          "value": "SeparateProcess",
          "type": "REG_DWORD",
          "data": 0
        }
      ]
    },
    {
      "id": "exp_classic_menu",
      "category": "explorer",
      "risk": "safe",
      "name": "Win11 恢复经典右键菜单",
      "desc": "跳过“显示更多选项”，直接显示完整右键菜单（需重启资源管理器生效）",
      "checkKey": "HKCU\\SOFTWARE\\Classes\\CLSID\\{86ca1aa0-34aa-4e8b-a509-50c905bae2a2}\\InprocServer32",
      "checkValue": "",
      "optimizedValue": "",
      "optimize": [
        {
          "op": "reg_set",
          "key": "HKCU\\SOFTWARE\\Classes\\CLSID\\{86ca1aa0-34aa-4e8b-a509-50c905bae2a2}\\InprocServer32",
          "value": "",
          "type": "REG_SZ",
          "data": ""
        }
      ],
      "restore": [
        {
          "op": "reg_del",
          "key": "HKCU\\SOFTWARE\\Classes\\CLSID\\{86ca1aa0-34aa-4e8b-a509-50c905bae2a2}",
          "value": ""
        }
      ]
    },
    {
      "id": "perf_menudelay",
      "category": "performance",
      "risk": "safe",
      "name": "加快菜单弹出速度",
      "desc": "把菜单弹出延迟从默认 400ms 降为 0",
      "checkKey": "HKCU\\Control Panel\\Desktop",
      "checkValue": "MenuShowDelay",
      "optimizedValue": 0,
      "optimize": [
        {
          "op": "reg_set",
          "key": "HKCU\\Control Panel\\Desktop",
          "value": "MenuShowDelay",
          "type": "REG_SZ",
          "data": "0"
        }
      ],
      "restore": [
        {
          "op": "reg_set",
          "key": "HKCU\\Control Panel\\Desktop",
          "value": "MenuShowDelay",
          "type": "REG_SZ",
          "data": "400"
        }
      ]
    },
    {
      "id": "perf_foreground",
      "category": "performance",
      "risk": "safe",
      "name": "前台程序优先获得响应",
      "desc": "缩短前台窗口锁定超时，界面更跟手",
      "checkKey": "HKCU\\Control Panel\\Desktop",
      "checkValue": "ForegroundLockTimeout",
      "optimizedValue": 0,
      "optimize": [
        {
          "op": "reg_set",
          "key": "HKCU\\Control Panel\\Desktop",
          "value": "ForegroundLockTimeout",
          "type": "REG_DWORD",
          "data": 0
        }
      ],
      "restore": [
        {
          "op": "reg_set",
          "key": "HKCU\\Control Panel\\Desktop",
          "value": "ForegroundLockTimeout",
          "type": "REG_DWORD",
          "data": 200000
        }
      ]
    },
    {
      "id": "perf_sysmain",
      "category": "performance",
      "risk": "safe",
      "name": "禁用 SysMain（超级预读）",
      "desc": "机械硬盘/小内存机器可减少后台磁盘占用；SSD 建议保留",
      "checkKey": "HKLM\\SYSTEM\\CurrentControlSet\\Services\\SysMain",
      "checkValue": "Start",
      "optimizedValue": 4,
      "optimize": [
        {
          "op": "svc",
          "name": "SysMain",
          "start": 4
        }
      ],
      "restore": [
        {
          "op": "svc",
          "name": "SysMain",
          "start": 2
        }
      ]
    },
    {
      "id": "perf_search",
      "category": "performance",
      "risk": "safe",
      "name": "禁用 Windows Search 索引",
      "desc": "省下索引占用的磁盘与内存；代价是开始菜单搜索变慢",
      "checkKey": "HKLM\\SYSTEM\\CurrentControlSet\\Services\\WSearch",
      "checkValue": "Start",
      "optimizedValue": 4,
      "optimize": [
        {
          "op": "svc",
          "name": "WSearch",
          "start": 4
        }
      ],
      "restore": [
        {
          "op": "svc",
          "name": "WSearch",
          "start": 2
        }
      ]
    },
    {
      "id": "perf_hibernate",
      "category": "performance",
      "risk": "safe",
      "name": "关闭休眠（释放 C 盘 hiberfil.sys）",
      "desc": "休眠文件通常占用内存大小的 40%，关闭可释放几个 GB",
      "checkKey": "HKLM\\SYSTEM\\CurrentControlSet\\Control\\Power",
      "checkValue": "HibernateEnabled",
      "optimizedValue": 0,
      "optimize": [
        {
          "op": "reg_set",
          "key": "HKLM\\SYSTEM\\CurrentControlSet\\Control\\Power",
          "value": "HibernateEnabled",
          "type": "REG_DWORD",
          "data": 0
        }
      ],
      "restore": [
        {
          "op": "reg_set",
          "key": "HKLM\\SYSTEM\\CurrentControlSet\\Control\\Power",
          "value": "HibernateEnabled",
          "type": "REG_DWORD",
          "data": 1
        }
      ]
    },
    {
      "id": "perf_fastboot",
      "category": "performance",
      "risk": "safe",
      "name": "关闭快速启动",
